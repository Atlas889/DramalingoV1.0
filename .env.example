# ─────────────────────────────────────────────────────────────
# DramaLingo 本地开发环境变量模板
# 使用方法：
#   cp .env.example .env
#   编辑 .env，填入真实值
#   启动前执行 set 命令加载（Windows）或 source（Mac/Linux）
# ─────────────────────────────────────────────────────────────

# ── 管理后台认证 ────────────────────────────────────────────
# 访问 /admin 页面时使用 Basic Auth
ADMIN_USER=admin
ADMIN_PASS=dramalingo2026

# ── AI 打标服务（必填，否则字幕处理无法打标） ────────────────
# 支持 DeepSeek 或 Qwen（OpenAI 兼容格式）
AI_PROVIDER=deepseek
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_API_BASE_URL=https://api.deepseek.com/v1

# 如果使用 Qwen，改为以下配置：
# AI_PROVIDER=qwen
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 日志级别 ─────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ── 文件存储根目录（视频、切片、字幕临时文件）────────────────
# 默认：E:\dramalingo-files，可改为任意本地路径
# 本地默认使用项目 data/ 目录；生产环境可改为独立磁盘路径
DRAMALINGO_FILES_ROOT=./data

# ── HuggingFace 镜像（国内必填，解决模型下载超时）────────────
HF_ENDPOINT=https://hf-mirror.com
